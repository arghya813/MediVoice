# ── MediVoice backend environment template ───────────────────────────────
# Copy this file to `.env` and fill in real values. NEVER commit `.env`.
#   cp backend/.env.example backend/.env

# --- Required secrets ---
# Google Gemini API key (https://aistudio.google.com/app/apikey)
GEMINI_API_KEY=your_gemini_api_key_here

# ElevenLabs API key (https://elevenlabs.io -> profile -> API Keys)
ELEVENLABS_API_KEY=your_elevenlabs_api_key_here

# Shared demo passcode required in the `X-Demo-Passcode` header
DEMO_PASSCODE=MEDIVOICE2026

# Comma-separated list of allowed browser origins (NO wildcards)
ALLOWED_ORIGINS=http://localhost:5173,https://your-frontend.example.com

# --- Optional settings ---
# Gemini model id
GEMINI_MODEL=gemini-3.8-flash

# SQLite database location
DATABASE_URL=sqlite:///./data/medivoice.db

# Max size (MB) for each uploaded label image
MAX_UPLOAD_MB=10
